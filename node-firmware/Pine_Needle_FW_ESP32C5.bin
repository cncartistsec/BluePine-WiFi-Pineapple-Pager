<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Pine Needle Node - ESP32C5 WiFi Config</title><style>
    body, html { margin: 0; padding: 0; height: 100%; color: #fff; font-family: 'Courier New', Courier, monospace; }
	.main-container { background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(10, 10, 25, 0.8)); /* background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(15, 20, 2, 0.8)), url('https://example.com'); */ background-size: cover; background-position: center; background-repeat: no-repeat; justify-content: center; position: relative; overflow: auto; height: 100%; }
	.login-box { background: rgba(15, 15, 30, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(0, 255, 255, 0.3); padding: 40px; max-width: 375px; box-shadow: 0 0 20px rgba(0, 255, 255, 0.2), inset 0 0 20px rgba(0, 255, 255, 0.1); border-radius: 10px; margin: 20px; margin-left: auto; margin-right: auto; }
	.login-box h2 { color: #00ffff; text-align: center; text-shadow: 0 0 5px #00ffff; margin-bottom: 30px; letter-spacing: 2px; font-size: 28px; }
	.login-box a { color: #00ffff; text-decoration: none; }
	.login-box a:hover { color: #a3ff00; text-decoration: underline; font-weight: bold; }
	.login-box a:visited { color: #78bc00; }
	.input-group { margin-bottom: 20px; }
	.input-group label { display: block; color: #fff; font-size: 0.9em; margin-bottom: 5px; }
	.input-group input, .input-group select { width: 100%; padding: 10px; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ffff; color: #ffffff; box-sizing: border-box; border-radius: 2px; }
	.input-group input:focus, .input-group select:focus { outline: none; box-shadow: 0 0 10px #00ffff; border: 1px solid #00ffff; }
	.neon-btn { width: 100%; padding: 12px; background: transparent; border: 2px solid #a3ff00; color: #ffffff; text-transform: uppercase; letter-spacing: 2px; font-weight: bold; cursor: pointer; box-shadow: 0 0 10px rgba(255, 0, 127, 0.3); transition: all 0.3s ease; margin-top: 10px; }
	.neon-btn:hover { background: #588012; box-shadow: 0 0 10px rgba(187, 255, 173, 0.3); }
	.config-text { font-size: 21px; font-weight: bold; }</style>
</head><body>
  <div class="main-container">
    <div class="login-box"><h2>PINE NEEDLE SETUP</h2>
		<form action="/save" method="POST">
            <div class="input-group"><label>Device/Server IP Address</label><input type="text" id="servip" name="servip" placeholder="10.42.0.1" value="10.42.0.1" required></div>
			<div class="input-group"><label>Available Network SSID&rsquo;s - Scan</label><select id="ssid" name="ssid"><option value="">Scanning for networks...</option></select></div>
            <div class="input-group"><label>Custom SSID - Manual Entry (OPTIONAL!!)</label><input type="text" id="ssidcust" name="ssidcust" placeholder="CustomNetworkSSID"></div>
            <div class="input-group"><label>Password</label><input type="password" id="password" name="password" placeholder="MyNeedleNetwork65432" required></div>
            <button type="submit" class="neon-btn">INITIALIZE</button>
        </form>
    </div>
	<br />
	<div class="login-box" style="padding: 25px; max-width: 950px; font-size: 18px;"><h2>NODE CONFIGURATION INSTRUCTIONS</h2>
		Default Debian Hotspot Server IP = <span class="config-text">10.42.0.1</span><br />
		Default Pager Mgmt AP Server IP = <span class="config-text">172.16.52.1</span><br /><br />
		Default Network SSID = <span class="config-text">NeedleNetwork</span><br />
		Default Network PW = <span class="config-text">MyNeedleNetwork65432</span><br /><br />
		Please input the Device/Server IP Address and enter your BluePine Device/Pager AP credentials to connect Nodes.<br /><br />
		All active Nodes should be connected to the same Network SSID.<br /><br />
		If AP SSID is not found in scan or offline at the time of setup, select &ldquo;Custom SSID Input&rdquo; in &ldquo;Available Network SSID&rsquo;s&rdquo; to allow entering of SSID in the &rdquo;Custom SSID&ldquo; field.<br /><br /><br />
		<div style="text-align: center; display: inline-block;">Links: <a href="https://github.com/cncartistsec/BluePine-WiFi-Pineapple-Pager/" target="_blank">BluePine</a> | <a href="https://github.com/cncartistsec/BluePine-WiFi-Pineapple-Pager/tree/main/node-firmware/" target="_blank">Latest Node Firmware</a></div>
		<div style="text-align: right; float: right;">FW Version <span class="config-text">1.0</span></div>
	</div>
  </div>
<script>
    // Asynchronously fetch networks when the page loads
    window.onload = function() {
        fetch('/scan')
            .then(response => response.json())
            .then(networks => {
                const selectElement = document.getElementById('ssid');
                selectElement.innerHTML = ''; // Clear out the "Scanning..." placeholder
                if (networks.length === 0) {
                    let opt = document.createElement('option');
                    opt.value = "noneBLANKSSIDnone";
                    opt.innerHTML = "No networks found";
                    selectElement.appendChild(opt);
                    return;
                }
                // Populate dropdown with found SSIDs
                networks.forEach(network => {
                    let opt = document.createElement('option');
                    opt.value = network.ssid;
                    opt.innerHTML = `${network.ssid} (${network.rssi})`;
                    selectElement.appendChild(opt);
                });
            })
            .catch(err => {
                console.error('Error fetching networks:', err);
                document.getElementById('ssid').innerHTML = '<option value="noneBLANKSSIDnone">Failed to load networks</option>';
            });
    };
</script>
